<script is:inline>
  (function () {
    var btn = document.getElementById('themeToggleBtn');
    var txt = document.getElementById('themeToggleText');
    function updateText() {
      var isDark = document.documentElement.classList.contains('dark') ||
                   document.documentElement.getAttribute('data-theme') === 'dark';
      if (txt) txt.textContent = isDark ? 'LIGHT' : 'DARK';
    }
    updateText();
    if (btn) {
      btn.addEventListener('click', function () {
        var isDark = document.documentElement.classList.contains('dark') ||
                     document.documentElement.getAttribute('data-theme') === 'dark';
        var nextDark = !isDark;
        if (nextDark) {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.classList.add('dark');
          localStorage.setItem('kojerens-theme', 'dark');
        } else {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.classList.remove('dark');
          localStorage.setItem('kojerens-theme', 'light');
        }
        updateText();
        window.dispatchEvent(new CustomEvent('themechange', { detail: { isDark: nextDark } }));
      });
    }
  })();
</script>
<script is:inline>
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('../sw.js').catch(function () {});
    });
  }
</script>

