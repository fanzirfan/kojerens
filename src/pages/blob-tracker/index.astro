---
import '../../styles/global.css';
import '../../styles/blob-tracker.css';
import { APP_VERSIONS } from '../../config/versions';
import MobileAdvisory from '../../components/MobileAdvisory.astro';
---

<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KOJERENS — Blob Tracker Studio</title>
  <link rel="canonical" href="https://kojerens.manji.eu.org/blob-tracker/" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Antonio:wght@400;700&family=Fraunces:ital,opsz,wght@0,9..144,300..800;1,9..144,300..800&family=Inter:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="icon" type="image/png" sizes="32x32" href="/blob-tracker/assets/brand/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/blob-tracker/assets/brand/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/blob-tracker/assets/brand/apple-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#141312" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />

  <!-- Anti-FOUC Theme Script -->
  <script is:inline>
    (function () {
      var saved = localStorage.getItem('kojerens-theme');
      if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
<body>
<div class="app">


  <!-- EDITORIAL TOPBAR -->
  <header class="topbar">
    <div class="topbar-brand">
      <a href="/" class="topbar-brand-link" title="Back to KOJERENS Studio">
        <span class="topbar-brand-star">✷</span>
        <span>KOJERENS</span>
      </a>
      <span class="topbar-subtool-badge">TRACKER</span>
      <span class="topbar-version-badge" title={`Blob Tracker ${APP_VERSIONS.blobTracker.version} (${APP_VERSIONS.blobTracker.releaseDate})`}>
        <span class="version-dot"></span>
        {APP_VERSIONS.blobTracker.version}
      </span>
    </div>

    <!-- ENGINE NAVIGATION LINKS -->
    <nav class="topbar-tools-nav" aria-label="Engine Navigation">
      <a href="/blob-tracker/" class="topbar-tool-switch active" title="Blob Tracker Engine">Blob Tracker</a>
      <a href="/ascii-gen/" class="topbar-tool-switch" title="Switch to ASCII Matrix Generator">ASCII Matrix</a>
      <a href="/dither-gen/" class="topbar-tool-switch" title="Switch to 1-Bit Dither Matrix">1-Bit Dither</a>
      <a href="/crt-gen/" class="topbar-tool-switch" title="Switch to Analog CRT Synthesizer">CRT Gen</a>
    </nav>

    <!-- TOPBAR ACTIONS -->
    <div class="topbar-actions">
      <button class="topbar-btn" id="themeToggleBtn" title="Toggle Dark / Light Theme">
        <span class="theme-toggle-icon">◑</span>
        <span id="themeToggleText">DARK</span>
      </button>
      <button class="topbar-btn" id="randomizeBtn" title="Randomize style and settings">
        Randomize
      </button>
      <button class="topbar-cta" id="topbarDownloadBtn">Export PNG</button>
    </div>
  </header>

  <!-- WORKSPACE -->
  <div class="workspace">

    <!-- TYPOGRAPHIC BROADSIDE RAIL (FAR LEFT) -->
    <nav class="rail" aria-label="Panel navigation">
      <button class="rail-btn active" data-panel="image" data-modes="all" title="Source File &amp; Crop" aria-pressed="true">
        <span class="rail-label">File</span>
      </button>
      <button class="rail-btn" data-panel="gradientmap" data-modes="all" title="Gradient Map" aria-pressed="false">
        <span class="rail-label">Map</span>
      </button>
      <button class="rail-btn" data-panel="pixelate" data-modes="all" title="Pixelate" aria-pressed="false">
        <span class="rail-label">Pixel</span>
      </button>
      <button class="rail-btn" data-panel="frametext" data-modes="all" title="Frame Text" aria-pressed="false">
        <span class="rail-label">Text</span>
      </button>
      <button class="rail-btn" data-panel="detection" data-modes="circles" title="Detection" aria-pressed="false">
        <span class="rail-label">Detect</span>
      </button>
      <button class="rail-btn" data-panel="shapes" data-modes="circles" title="Visual Style" aria-pressed="false">
        <span class="rail-label">Visual</span>
      </button>
      <button class="rail-btn" data-panel="palette" data-modes="all" title="Palette" aria-pressed="false">
        <span class="rail-label">Palette</span>
      </button>
      <button class="rail-btn" data-panel="crosshair" data-modes="all" data-engine="true" title="Engine Settings" aria-pressed="false">
        <span class="rail-label">Engine</span>
      </button>
      <div class="rail-sep"></div>
      <button class="rail-btn" data-panel="size" data-modes="all" title="Canvas Size" aria-pressed="false">
        <span class="rail-label">Size</span>
      </button>
      <button class="rail-btn" data-panel="texture" data-modes="all" title="Texture / Noise" aria-pressed="false">
        <span class="rail-label">Noise</span>
      </button>
      <button class="rail-btn" data-panel="export" data-modes="all" title="Export &amp; Actions" aria-pressed="false">
        <span class="rail-label">Export</span>
      </button>
    </nav>

    <!-- PANEL DRAWER (MIDDLE LEFT) -->
    <aside class="panel-drawer open" id="panelDrawer">
      <div class="drawer-inner sidebar">

        <!-- SECTION 0: VISUAL ENGINE PRESETS (MOVED TO RIGHT PANEL) -->
        <section class="panel" data-section="modes" data-modes="all">
          <div class="panel-header">
            <span class="panel-title"><i class="panel-dot"></i> VISUAL ENGINE</span>
            <button class="toggle-collapse" aria-label="Collapse section">−</button>
          </div>
          <div class="panel-body">
            <p class="hint">Instant computational tracking engine</p>
            <div class="preset-pill-grid">
              <button class="preset-pill-btn active" data-mode="circles">Sensor</button>
              <button class="preset-pill-btn" data-mode="hero">Telemetry</button>
              <button class="preset-pill-btn" data-mode="geo">Topography</button>
              <button class="preset-pill-btn" data-mode="studio">Viewfinder</button>
            </div>
          </div>
        </section>

        <!-- SECTION 1: FILE SOURCE & CROP -->
        <section class="panel" data-section="image" data-modes="all">
          <div class="panel-header">
            <span class="panel-title"><i class="panel-dot"></i> FILE SOURCE &amp; CROP</span>
            <button class="toggle-collapse" aria-label="Collapse section">−</button>
          </div>
          <div class="panel-body">
            <button class="btn-block" id="replaceImageBtn">Select / Replace File</button>
            <input type="file" id="imageInput" style="display:none" />

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 8px;">
              <button class="btn-block-outline" id="cropBtn" title="Crop or frame the source image">
                <i class="ri-crop-line"></i> Crop Image
              </button>
              <button class="btn-block-outline" id="loadSampleBtn" title="Choose a demo photo from library">
                <i class="ri-gallery-line"></i> Demo Library
              </button>
            </div>

            <!-- Demo Library Dropdown -->
            <div id="demoPickerPanel" style="display:none; background: var(--color-paper); border: 1px solid var(--color-glass-edge); border-radius: 12px; padding: 10px; margin-bottom: 10px;">
              <span class="field-sublabel" style="display:block; margin-bottom: 6px; color: var(--color-moon-mist); font-size:9.5px;">SELECT DEMO PHOTO:</span>
              <div style="display: flex; flex-direction: column; gap: 4px;">
                <button class="btn-demo-item" data-demo="street">1. Cyber Street (Tokyo Night)</button>
                <button class="btn-demo-item" data-demo="arch">2. Architecture (Brutalist Form)</button>
                <button class="btn-demo-item" data-demo="portrait">3. Studio Portrait (High Contrast)</button>
                <button class="btn-demo-item" data-demo="procedural">4. Procedural Vector Target</button>
              </div>
            </div>

            <div class="control-group">
              <div class="control-header">
                <label>FILE OPACITY</label>
                <span class="val" id="imageOpacityVal">0.75</span>
              </div>
              <p class="hint">Fade the background file</p>
              <input type="range" id="imageOpacity" min="0" max="1" step="0.01" value="0.75" />
            </div>
          </div>
        </section>

    <!-- SECTION: GRADIENT MAP -->
    <section class="panel" data-section="gradientmap" data-modes="all">
      <div class="panel-header">
        <span class="panel-title">GRADIENT MAP</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <button class="btn-toggle" id="gradientMapToggleBtn">Gradient Map Off</button>

        <div class="control-group">
          <div class="control-header">
            <label>PRESET (40 MAPS)</label>
            <span class="val" id="gradientMapPresetVal">Gradient 01</span>
          </div>
          <div class="select-wrap">
            <select id="gradientMapSelect" aria-label="Select Gradient Map Preset">
            </select>
          </div>
        </div>

        <div class="gradient-preview-strip" id="gradientMapStrip" title="Active Gradient Map Preview"></div>

        <div class="control-group">
          <div class="control-header">
            <label>QUICK SWATCHES</label>
          </div>
          <div class="gradient-swatches-grid" id="gradientSwatchesGrid" aria-label="Gradient Map Presets Swatches">
          </div>
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>BLEND OPACITY</label>
            <span class="val" id="gradientMapOpacityVal">1.0</span>
          </div>
          <p class="hint">Intensity of color remapping</p>
          <input type="range" id="gradientMapOpacity" min="0" max="1" step="0.01" value="1.0" />
        </div>

        <div class="btn-row">
          <button class="btn-toggle" id="gradientMapInvertBtn">Invert Off</button>
          <button class="btn-action" id="randomizeGradientBtn">Random Map</button>
        </div>

        <div style="margin-top: 10px;">
          <button class="btn-action" id="importGrdBtn" style="width: 100%;">Import .GRD File</button>
          <input type="file" id="grdFileInput" accept=".grd" style="display:none" />
        </div>
      </div>
    </section>

    <!-- SECTION 2: PIXELATE -->
    <section class="panel" data-section="pixelate" data-modes="all">
      <div class="panel-header">
        <span class="panel-title">PIXELATE</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <p class="hint intro">Click on the canvas to place pixelation zones</p>

        <div class="control-group">
          <div class="control-header">
            <label>PIXEL SIZE</label>
            <span class="val" id="pixelSizeVal">26</span>
          </div>
          <p class="hint">Mosaic block size: larger = blockier</p>
          <input type="range" id="pixelSize" min="4" max="60" value="26" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>ZONE SIZE</label>
            <span class="val" id="zoneSizeVal">90</span>
          </div>
          <p class="hint">Half-width of each square pixelation zone</p>
          <input type="range" id="zoneSize" min="20" max="250" value="90" />
        </div>

        <button class="btn-toggle active" id="pixelateStrokeBtn">Stroke On</button>

        <div class="btn-row">
          <button class="btn-action" id="undoPixelateBtn">Undo</button>
          <button class="btn-action" id="clearPixelateBtn">Clear</button>
        </div>
        <p class="status-sub" id="pixelateStatus">0 zones placed</p>
      </div>
    </section>

    <!-- SECTION: FRAME TEXT -->
    <section class="panel" data-section="frametext" data-modes="all">
      <div class="panel-header">
        <span class="panel-title">FRAME TEXT</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <button class="btn-toggle" id="frameTextToggleBtn">Frame Text Off</button>

        <div class="control-group">
          <div class="control-header">
            <label>TEXT SIZE</label>
            <span class="val" id="frameTextSizeVal">12</span>
          </div>
          <p class="hint">Font size of the 4 corner labels</p>
          <input type="range" id="frameTextSize" min="6" max="40" step="1" value="12" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>TOP LEFT</label>
          </div>
          <input type="text" id="frameTextTL" class="input-text" value="Design & Strategy" placeholder="Top Left text..." />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>TOP RIGHT</label>
          </div>
          <input type="text" id="frameTextTR" class="input-text" value="Fanz Irfan" placeholder="Top Right text..." />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>BOTTOM LEFT</label>
          </div>
          <input type="text" id="frameTextBL" class="input-text" value="manji.eu.org" placeholder="Bottom Left text..." />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>BOTTOM RIGHT</label>
          </div>
          <input type="text" id="frameTextBR" class="input-text" value="Indonesia" placeholder="Bottom Right text..." />
        </div>
      </div>
    </section>

    <!-- SECTION 3: CROSSHAIR FRAME -->
    <section class="panel" data-section="crosshair" data-modes="circles">
      <div class="panel-header">
        <span class="panel-title">CROSSHAIR FRAME</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <button class="btn-toggle active" id="frameToggleBtn">Frame On</button>

        <div class="control-group">
          <div class="control-header">
            <label>FRAME WIDTH</label>
            <span class="val" id="frameWidthVal">60</span>
          </div>
          <p class="hint">Frame width as % of canvas width</p>
          <input type="range" id="frameWidth" min="10" max="100" value="60" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>FRAME HEIGHT</label>
            <span class="val" id="frameHeightVal">60</span>
          </div>
          <p class="hint">Frame height as % of canvas height</p>
          <input type="range" id="frameHeight" min="10" max="100" value="60" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>DASH PATTERN</label>
            <span class="val" id="dashPatternVal">8</span>
          </div>
          <p class="hint">Length of each dash + gap</p>
          <input type="range" id="dashPattern" min="2" max="30" value="8" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>STROKE</label>
            <span class="val" id="frameStrokeVal">1.0</span>
          </div>
          <p class="hint">Line thickness for frame and crosshair</p>
          <input type="range" id="frameStroke" min="0.2" max="5.0" step="0.1" value="1.0" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>STAR SIZE</label>
            <span class="val" id="starSizeVal">40</span>
          </div>
          <p class="hint">Diameter of the center asterisk (0 hides it)</p>
          <input type="range" id="starSize" min="0" max="150" value="40" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>STAR POINTS</label>
            <span class="val" id="starPointsVal">4</span>
          </div>
          <p class="hint">Number of crossing lines: 2 is a plus, 4 is an 8-pointed star</p>
          <input type="range" id="starPoints" min="1" max="8" value="4" />
        </div>
      </div>
    </section>

    <!-- SECTION 4: CHAIN -->
    <section class="panel" data-section="chain" data-modes="circles">
      <div class="panel-header">
        <span class="panel-title">CHAIN</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <button class="btn-toggle active" id="chainToggleBtn">Chain On</button>

        <div class="control-group">
          <div class="control-header">
            <label>COUNT</label>
            <span class="val" id="chainCountVal">11</span>
          </div>
          <p class="hint">Number of circles in the chain</p>
          <input type="range" id="chainCount" min="1" max="25" value="11" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>ANGLE</label>
            <span class="val" id="chainAngleVal">45</span>
          </div>
          <p class="hint">Direction of chain: 0 vertical, 45 diagonal, 90 horizontal</p>
          <input type="range" id="chainAngle" min="0" max="180" value="45" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>BASE RADIUS</label>
            <span class="val" id="chainBaseRadiusVal">300</span>
          </div>
          <p class="hint">Size of the center circle</p>
          <input type="range" id="chainBaseRadius" min="30" max="600" value="300" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>SIZE RATIO</label>
            <span class="val" id="chainSizeRatioVal">0.50</span>
          </div>
          <p class="hint">Size multiplier per step: below 1 shrinks outward</p>
          <input type="range" id="chainSizeRatio" min="0.2" max="1.2" step="0.01" value="0.50" />
        </div>

        <button class="btn-toggle active" id="chainIntersectionsBtn">Intersections On</button>

        <div class="control-group">
          <div class="control-header">
            <label>MARKER SIZE</label>
            <span class="val" id="markerSizeVal">3.0</span>
          </div>
          <p class="hint">Dot size at each adjacent-circle intersection</p>
          <input type="range" id="markerSize" min="0.5" max="10" step="0.5" value="3.0" />
        </div>
      </div>
    </section>

    <!-- SECTION 5: DETECTION -->
    <section class="panel" data-section="detection" data-modes="circles">
      <div class="panel-header">
        <span class="panel-title">DETECTION</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <div class="segmented-group">
          <button class="seg-btn" data-detection-mode="combined">Combined</button>
          <button class="seg-btn active" data-detection-mode="contrast">Contrast</button>
        </div>

        <div class="segmented-group">
          <button class="seg-btn" data-detection-mode="bright">Bright</button>
          <button class="seg-btn" data-detection-mode="dark">Dark</button>
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>BLOCK SIZE</label>
            <span class="val" id="blockSizeVal">16</span>
          </div>
          <p class="hint">Analysis grid resolution: smaller = more detail</p>
          <input type="range" id="blockSize" min="6" max="40" value="16" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>THRESHOLD</label>
            <span class="val" id="thresholdVal">30</span>
          </div>
          <p class="hint">Min score to place a circle: higher = fewer, stronger hits</p>
          <input type="range" id="threshold" min="0" max="100" value="30" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>MAX CIRCLES</label>
            <span class="val" id="maxCirclesVal">80</span>
          </div>
          <p class="hint">Cap on total circles placed</p>
          <input type="range" id="maxCircles" min="10" max="200" value="80" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>MIN DISTANCE</label>
            <span class="val" id="minDistanceVal">40</span>
          </div>
          <p class="hint">Spacing between circle centers: prevents clustering</p>
          <input type="range" id="minDistance" min="10" max="120" value="40" />
        </div>
      </div>
    </section>

    <!-- SECTION 6: SHAPES -->
    <section class="panel" data-section="shapes" data-modes="circles">
      <div class="panel-header">
        <span class="panel-title">SHAPES</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <div class="segmented-group">
          <button class="seg-btn active" data-shape="circle">Circle</button>
          <button class="seg-btn" data-shape="square">Square</button>
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>MIN RADIUS</label>
            <span class="val" id="minRadiusVal">4</span>
          </div>
          <p class="hint">Smallest circle size (low-score regions)</p>
          <input type="range" id="minRadius" min="1" max="40" value="4" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>MAX RADIUS</label>
            <span class="val" id="maxRadiusVal">24</span>
          </div>
          <p class="hint">Largest circle size (high-score regions)</p>
          <input type="range" id="maxRadius" min="6" max="100" value="24" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>STROKE</label>
            <span class="val" id="shapeStrokeVal">1.0</span>
          </div>
          <p class="hint">Circle outline thickness</p>
          <input type="range" id="shapeStroke" min="0.2" max="5.0" step="0.1" value="1.0" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>SIZE SEED</label>
            <span class="val" id="sizeSeedVal">42</span>
          </div>
          <p class="hint">Random seed for size variation: change for different distributions</p>
          <input type="range" id="sizeSeed" min="1" max="9999" value="42" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>LABEL SIZE</label>
            <span class="val" id="labelSizeVal">8</span>
          </div>
          <p class="hint">Font size of xy coordinate labels</p>
          <input type="range" id="labelSize" min="4" max="20" value="8" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>OVERLAY OPACITY</label>
            <span class="val" id="overlayOpacityVal">1.00</span>
          </div>
          <p class="hint">Master opacity for all circles, lines, dots, and text</p>
          <input type="range" id="overlayOpacity" min="0" max="1" step="0.01" value="1.00" />
        </div>
      </div>
    </section>

    <!-- SECTION 7: CONNECTIONS -->
    <section class="panel" data-section="connections" data-modes="circles">
      <div class="panel-header">
        <span class="panel-title">CONNECTIONS</span>
        <button class="toggle-collapse" aria-label="Collapse section">−</button>
      </div>
      <div class="panel-body">
        <div class="control-group">
          <div class="control-header">
            <label>MAX DISTANCE</label>
            <span class="val" id="maxDistanceVal">150</span>
          </div>
          <p class="hint">Circles within this range get connected (0 hides lines)</p>
          <input type="range" id="maxDistance" min="0" max="400" value="150" />
        </div>

        <div class="control-group">
          <div class="control-header">
            <label>LINE WEIGHT</label>
            <span class="val" id="lineWeightVal">0.8</span>
          </div>
          <p class="hint">Thickness of connecting lines</p>
