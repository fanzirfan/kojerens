---
import '../styles/global.css';
import '../styles/landing.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KOJERENS | Generative Visual & Computational Design Studio</title>
  <meta name="description" content="KOJERENS: A browser-native generative visual laboratory featuring high-performance contrast centroid tracking, HUD telemetry, Unicode ASCII art, 1-bit error-diffusion dithering, and analog CRT beam glitch synthesis." />
  <meta name="keywords" content="kojerens, generative design, visual engineering, blob tracker, ascii art, dither, 1-bit, crt synthesizer, scanlines, trinitron, analog glitch, creative coding, browser-native" />
  <meta name="author" content="Fanz Irfan" />
  <meta name="robots" content="index,follow" />

  <!-- Open Graph -->
  <meta property="og:title" content="KOJERENS | Generative Visual & Design Studio" />
  <meta property="og:description" content="Explore client-side generative visual engines: Blob Tracker, ASCII Matrix Generator, 1-Bit Dither Matrix & Analog CRT Synthesizer." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manji.eu.org" />
  <meta property="og:image" content="/assets/brand/logo.png" />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/brand/favicon-48x48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#05060f" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
</head>
<body>

  <!-- NAVIGATION -->
  <nav class="navbar" aria-label="Main Navigation">
    <div class="nav-brand">
      <a href="index.html" style="display:flex; align-items:center; gap:10px;">
        <img src="/assets/brand/navbar.png" alt="KOJERENS" class="nav-logo" width="28" height="28" />
        <span class="nav-title">KOJERENS</span>
      </a>
      <span class="nav-badge">STUDIO LAB</span>
    </div>

    <div class="nav-links">
      <a href="#tools" class="nav-link">Studio Engines</a>
      <a href="#features" class="nav-link">Architecture</a>
      <a href="#about" class="nav-link">Manifesto</a>
    </div>

    <div class="nav-actions">
      <a href="https://github.com/fanzirfan/blob-track" target="_blank" rel="noopener" class="btn-ghost" title="GitHub Repository">
        <i class="ri-github-line"></i> GitHub
      </a>
      <a href="#tools" class="btn-cta">
        Launch Tools <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </nav>

  <!-- HERO SECTION -->
  <header class="hero-section">
    <div class="hero-eyebrow">
      <span class="eyebrow-dot"></span>
      <span>COMPUTATIONAL VISUAL STUDIO : 100% IN-BROWSER</span>
    </div>

    <h1 class="hero-title">
      Generative Systems for Modern Visual Engineers.
    </h1>

    <p class="hero-description">
      KOJERENS is a browser-native generative laboratory engineered for luminance contrast centroid tracking, technical vector telemetry, real-time Unicode ASCII art synthesis, and 1-bit error-diffusion dithering.
    </p>

    <div class="hero-buttons">
      <a href="#tools" class="btn-cta btn-large">
        <i class="ri-compass-3-line"></i> Explore Creative Engines
      </a>
      <a href="https://github.com/fanzirfan/blob-track" target="_blank" rel="noopener" class="btn-ghost btn-large">
        <i class="ri-code-s-slash-line"></i> View Source Code
      </a>
    </div>

    <!-- Live Telemetry Simulator Strip -->
    <div class="hero-telemetry-strip" aria-label="Live Laboratory Simulation">
      <div class="telemetry-grid-header">
        <div class="telemetry-status-tag">
          <i class="ri-pulse-line" style="color: var(--color-void-violet);"></i>
          <span>LIVE HARDWARE ACCELERATED RENDER PIPELINE</span>
        </div>
        <div>MANJI.EU.ORG // 2026</div>
      </div>
      <canvas id="heroHudCanvas" class="hud-preview-canvas" width="960" height="240"></canvas>
    </div>
  </header>

  <!-- STUDIO TOOLS SECTION (#tools) -->
  <main>
    <section class="section-container" id="tools">
      <div class="section-header">
        <div class="section-eyebrow">// PRODUCTION ENGINES</div>
        <h2 class="section-title">Generative Online Tools</h2>
        <p class="section-subtitle">
          Engineered for visual researchers, art directors, and creative technologists. Zero installations, zero tracking, pure client-side computing.
        </p>
      </div>

      <div class="tools-grid">
        
        <!-- TOOL 1: BLOB TRACKER -->
        <article class="tool-card">
          <span class="tool-card-corner-bracket">[01]</span>
          
          <div class="tool-header">
            <span class="tool-index">VECTOR TELEMETRY & CENTROID TRACKER</span>
            <h3 class="tool-title">Blob Tracker</h3>
            <p class="tool-description">
              Upload any image to analyze high-contrast feature centroids. Generate sci-fi HUD telemetry, topographic geodetic contour lines, constellations, and minimalist editorial framing.
            </p>
          </div>

          <div class="tool-preview-box">
            <canvas id="blobPreviewCanvas" class="preview-interactive-canvas" width="480" height="200"></canvas>
          </div>

          <div class="tool-tags">
            <span class="tool-tag">Sensor Constellation</span>
            <span class="tool-tag">Sci-Fi Telemetry</span>
            <span class="tool-tag">Marching Squares Topo</span>
            <span class="tool-tag">40 GRD Gradient Maps</span>
            <span class="tool-tag">Transparent PNG Export</span>
          </div>

          <div class="tool-cta-row">
            <span class="tool-spec-badge">4 Engines · 60/120fps GPU</span>
            <a href="/blob-tracker/" class="btn-cta">
              Open Blob Tracker <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </article>

        <!-- TOOL 2: ASCII MATRIX GENERATOR -->
        <article class="tool-card">
          <span class="tool-card-corner-bracket">[02]</span>
          
          <div class="tool-header">
            <span class="tool-index">UNICODE GLYPH SYNTHESIZER</span>
            <h3 class="tool-title">ASCII Matrix</h3>
            <p class="tool-description">
              Transform still imagery, recorded video streams, and real-time webcam feeds into rich multi-language Unicode character art. Features multi-pass bloom, photographic exposure, and sequence ZIP export.
            </p>
          </div>

          <div class="tool-preview-box">
            <canvas id="asciiPreviewCanvas" class="preview-interactive-canvas" width="480" height="200"></canvas>
          </div>

          <div class="tool-tags">
            <span class="tool-tag">Unicode Character Ramps</span>
            <span class="tool-tag">Live Webcam Input</span>
            <span class="tool-tag">Video Sequence ZIP</span>
            <span class="tool-tag">Multi-Pass Bloom</span>
            <span class="tool-tag">Pure Text Download</span>
          </div>

          <div class="tool-cta-row">
            <span class="tool-spec-badge">Webcam · Video · Text Export</span>
            <a href="/ascii-gen/" class="btn-cta">
              Open ASCII Matrix <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </article>

        <!-- TOOL 3: 1-BIT DITHER MATRIX -->
        <article class="tool-card">
          <span class="tool-card-corner-bracket">[03]</span>
          
          <div class="tool-header">
            <span class="tool-index">1-BIT ERROR DIFFUSION &amp; ORDERED DITHERING</span>
            <h3 class="tool-title">1-Bit Dither</h3>
            <p class="tool-description">
              Synthesize photographs into high-contrast retro bitmap graphics using 15 dithering algorithms. Atkinson, Floyd-Steinberg, Bayer matrices, halftone screens, retro palettes, and vector SVG export.
            </p>
          </div>

          <div class="tool-preview-box">
            <canvas id="ditherPreviewCanvas" class="preview-interactive-canvas" width="480" height="200"></canvas>
          </div>

          <div class="tool-tags">
            <span class="tool-tag">15 Dither Engines</span>
            <span class="tool-tag">Bayer 8x8 &amp; Halftone</span>
            <span class="tool-tag">12 Retro Palettes</span>
            <span class="tool-tag">Scalable SVG Export</span>
            <span class="tool-tag">Integer Pixel Scale</span>
          </div>

          <div class="tool-cta-row">
            <span class="tool-spec-badge">15 Engines · SVG &amp; PNG</span>
            <a href="/dither-gen/" class="btn-cta">
              Open 1-Bit Dither <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </article>

        <!-- TOOL 4: ANALOG CRT BEAM & GLITCH SYNTHESIZER -->
        <article class="tool-card">
          <span class="tool-card-corner-bracket">[04]</span>
          
          <div class="tool-header">
            <span class="tool-index">ANALOG BEAM DYNAMICS &amp; GLITCH</span>
            <h3 class="tool-title">CRT Synthesizer</h3>
            <p class="tool-description">
              Simulate cathode ray tube physics, Trinitron aperture grilles, triad shadow masks, electron beam bloom, chromatic aberration, NTSC composite color bleed, and VHS tracking jitter.
            </p>
          </div>

          <div class="tool-preview-box">
            <canvas id="crtPreviewCanvas" class="preview-interactive-canvas" width="480" height="200"></canvas>
          </div>

          <div class="tool-tags">
            <span class="tool-tag">Trinitron Aperture Grille</span>
            <span class="tool-tag">Triad Shadow Mask</span>
            <span class="tool-tag">Barrel Tube Curvature</span>
            <span class="tool-tag">VHS Sync Jitter</span>
            <span class="tool-tag">Transparent Overlay Export</span>
          </div>

          <div class="tool-cta-row">
            <span class="tool-spec-badge">8 Presets · Broadcast OSD</span>
            <a href="/crt-gen/" class="btn-cta">
              Open CRT Synthesizer <i class="ri-arrow-right-line"></i>
            </a>
          </div>
        </article>

      </div>
    </section>

    <!-- ARCHITECTURE & CAPABILITIES (#features) -->
    <section class="section-container" id="features">
      <div class="section-header">
        <div class="section-eyebrow">// CORE ARCHITECTURE</div>
        <h2 class="section-title">Built for Precision & Privacy</h2>
        <p class="section-subtitle">
          Traditional online design tools send your private imagery to remote servers. KOJERENS executes all computer vision algorithms locally within your browser context.
        </p>
      </div>

      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrap">
            <i class="ri-shield-check-line"></i>
          </div>
          <h4 class="feature-title">Zero Server Footprint</h4>
          <p class="feature-text">
            100% client-side execution. Your photos, videos, and camera feeds remain in local memory and never touch an external cloud server.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap">
            <i class="ri-cpu-line"></i>
          </div>
          <h4 class="feature-title">Hardware Accelerated</h4>
          <p class="feature-text">
            Offscreen canvas buffers paired with requestAnimationFrame scheduling deliver fluid 60fps to 120fps slider response times even at 4K resolution.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap">
            <i class="ri-layout-grid-line"></i>
          </div>
          <h4 class="feature-title">Dynamic Workspaces</h4>
          <p class="feature-text">
            Adaptive icon rails and sliding panel drawers maximize your visual canvas area, keeping complex generative parameter controls accessible yet uncluttered.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon-wrap">
            <i class="ri-download-cloud-line"></i>
          </div>
          <h4 class="feature-title">Production Exports</h4>
          <p class="feature-text">
            Export transparent PNG overlays, full resolution branded posters, animated frame sequences in ZIP archives, and raw ASCII plaintext ready for production.
          </p>
        </div>
      </div>
    </section>

    <!-- MANIFESTO & ABOUT (#about) -->
    <section class="section-container" id="about">
      <div class="manifesto-card">
        <div>
          <h2 class="manifesto-title">The KOJERENS Creative Manifesto</h2>
          <p class="manifesto-p">
            In an era of generic AI templates and bloated subscriptions, KOJERENS returns control to procedural rules, mathematical aesthetics, and direct pixel manipulation.
          </p>
          <p class="manifesto-p">
            Whether generating sci-fi interface assets for film, topographic geodetic charts for editorial prints, or retro-futuristic ASCII motion clips, each tool in this suite is purpose-built to inspire new visual languages.
          </p>
          <div style="margin-top: 24px;">
            <a href="https://github.com/fanzirfan/blob-track" target="_blank" rel="noopener" class="btn-ghost">
              <i class="ri-star-line"></i> Star on GitHub
            </a>
          </div>
        </div>

        <div class="manifesto-aside">
          <div class="aside-row">
            <span>Project</span>
            <span class="aside-val">KOJERENS Visual Lab</span>
          </div>
          <div class="aside-row">
            <span>Engineering & Design</span>
            <span class="aside-val">Fanz Irfan</span>
          </div>
          <div class="aside-row">
            <span>Primary Host Domain</span>
            <span class="aside-val">manji.eu.org</span>
          </div>
          <div class="aside-row">
            <span>Technology Stack</span>
            <span class="aside-val">Vanilla HTML5 · Canvas2D · CSS3</span>
          </div>
          <div class="aside-row">
            <span>License</span>
            <span class="aside-val">Open Source (MIT)</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-brand">
          <a href="index.html" class="footer-brand-link">
            <img src="/assets/brand/footer.png" alt="KOJERENS" width="24" height="24" />
            <span class="footer-brand-title">KOJERENS</span>
          </a>
          <span class="footer-tagline">Computational Visual Studio · 100% In-Browser</span>
        </div>

        <nav class="footer-links" aria-label="Footer Navigation">
          <a href="/blob-tracker/">Blob Tracker</a>
          <a href="/ascii-gen/">ASCII Matrix</a>
          <a href="/dither-gen/">1-Bit Dither</a>
          <a href="/crt-gen/">CRT Synthesizer</a>
          <a href="https://github.com/fanzirfan/blob-track" target="_blank" rel="noopener">GitHub</a>
          <a href="https://manji.eu.org" target="_blank" rel="noopener">manji.eu.org</a>
        </nav>
      </div>

      <div class="footer-bottom">
        <div class="footer-attribution">
          Crafted by <strong>Fanz Irfan</strong> · <a href="https://manji.eu.org" target="_blank" rel="noopener">manji.eu.org</a> · 2026
        </div>
        <div class="footer-status">
          <span class="status-indicator"></span>
          <span>SYSTEM ONLINE · ZERO SERVER DEPENDENCY</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- Interactive Visual Simulation Script -->
  <script is:inline>
    (function () {
      // 1. Hero HUD Canvas Simulation
      var heroCanvas = document.getElementById('heroHudCanvas');
      if (heroCanvas) {
        var hctx = heroCanvas.getContext('2d');
        var width, height;
        var nodes = [];
        var numNodes = 24;

        function resizeHero() {
          var rect = heroCanvas.getBoundingClientRect();
          heroCanvas.width = rect.width;
          heroCanvas.height = 240;
          width = heroCanvas.width;
          height = heroCanvas.height;

          nodes = [];
          for (var i = 0; i < numNodes; i++) {
            nodes.push({
              x: Math.random() * width,
              y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.8,
              vy: (Math.random() - 0.5) * 0.8,
              r: Math.random() * 2.5 + 1.5,
              id: 'TRK-' + (100 + i)
            });
          }
        }
        resizeHero();
        window.addEventListener('resize', resizeHero);

        var angle = 0;
        function renderHero() {
          if (!hctx || !width) return;
          hctx.clearRect(0, 0, width, height);

          // Technical perspective grid lines
          hctx.strokeStyle = 'rgba(186, 215, 247, 0.05)';
          hctx.lineWidth = 1;
          var step = 40;
          for (var x = 0; x < width; x += step) {
            hctx.beginPath();
            hctx.moveTo(x, 0);
            hctx.lineTo(x, height);
            hctx.stroke();
          }
          for (var y = 0; y < height; y += step) {
            hctx.beginPath();
            hctx.moveTo(0, y);
            hctx.lineTo(width, y);
            hctx.stroke();
          }

          // Rotating radar circle in center
          var cx = width / 2;
          var cy = height / 2;
          var radarRadius = Math.min(width, height) * 0.42;

          hctx.strokeStyle = 'rgba(102, 58, 243, 0.25)';
          hctx.beginPath();
          hctx.arc(cx, cy, radarRadius, 0, Math.PI * 2);
          hctx.stroke();

          hctx.strokeStyle = 'rgba(186, 215, 247, 0.15)';
          hctx.beginPath();
          hctx.arc(cx, cy, radarRadius * 0.5, 0, Math.PI * 2);
          hctx.stroke();

          // Radar sweep line
          angle += 0.015;
          hctx.save();
          hctx.translate(cx, cy);
          hctx.rotate(angle);
          hctx.strokeStyle = 'rgba(216, 236, 248, 0.5)';
          hctx.beginPath();
          hctx.moveTo(0, 0);
          hctx.lineTo(radarRadius, 0);
          hctx.stroke();
          hctx.restore();

          // Constellation lines & nodes
          for (var i = 0; i < nodes.length; i++) {
            var n1 = nodes[i];
            n1.x += n1.vx;
            n1.y += n1.vy;
            if (n1.x < 0 || n1.x > width) n1.vx *= -1;
            if (n1.y < 0 || n1.y > height) n1.vy *= -1;

            for (var j = i + 1; j < nodes.length; j++) {
              var n2 = nodes[j];
              var dx = n2.x - n1.x;
              var dy = n2.y - n1.y;
              var dist = Math.sqrt(dx * dx + dy * dy);
              if (dist < 110) {
                hctx.strokeStyle = 'rgba(102, 58, 243, ' + (0.35 * (1 - dist / 110)) + ')';
                hctx.lineWidth = 1;
                hctx.beginPath();
                hctx.moveTo(n1.x, n1.y);
                hctx.lineTo(n2.x, n2.y);
                hctx.stroke();
              }
            }

            // Draw node dot
            hctx.fillStyle = '#d1e4fa';
            hctx.beginPath();
            hctx.arc(n1.x, n1.y, n1.r, 0, Math.PI * 2);
            hctx.fill();

            // Label coordinate
            if (i % 3 === 0) {
              hctx.font = '9px "JetBrains Mono", monospace';
              hctx.fillStyle = 'rgba(186, 215, 247, 0.5)';
              hctx.fillText(Math.round(n1.x) + ',' + Math.round(n1.y), n1.x + 6, n1.y - 4);
            }
          }

          requestAnimationFrame(renderHero);
        }
        renderHero();
      }

      // 2. Blob Tracker Preview Canvas Simulation
      var blobCanvas = document.getElementById('blobPreviewCanvas');
      if (blobCanvas) {
        var bctx = blobCanvas.getContext('2d');
        var bw = blobCanvas.width;
        var bh = blobCanvas.height;
        var t = 0;

        function renderBlobPreview() {
          t += 0.02;
          bctx.clearRect(0, 0, bw, bh);

          // Draw concentric topographic & HUD circles
          var cx = bw / 2;
          var cy = bh / 2;

          for (var r = 25; r <= 85; r += 20) {
            bctx.strokeStyle = 'rgba(186, 215, 247, 0.15)';
            bctx.lineWidth = 1;
            bctx.setLineDash([4, 4]);
            bctx.beginPath();
            bctx.arc(cx, cy, r + Math.sin(t + r * 0.1) * 3, 0, Math.PI * 2);
            bctx.stroke();
          }
          bctx.setLineDash([]);

          // Crosshairs
          bctx.strokeStyle = 'rgba(102, 58, 243, 0.5)';
          bctx.beginPath();
          bctx.moveTo(cx - 90, cy);
          bctx.lineTo(cx + 90, cy);
          bctx.moveTo(cx, cy - 70);
          bctx.lineTo(cx, cy + 70);
          bctx.stroke();

          // Centroid blobs
          var points = [
            { x: cx + Math.cos(t) * 45, y: cy + Math.sin(t * 1.3) * 35, r: 6 },
            { x: cx - Math.cos(t * 0.8) * 55, y: cy - Math.sin(t) * 40, r: 8 },
            { x: cx + Math.sin(t * 1.2) * 60, y: cy - Math.cos(t * 0.9) * 45, r: 5 }
          ];

          points.forEach(function (p, idx) {
            bctx.strokeStyle = '#663af3';
            bctx.lineWidth = 1.5;
            bctx.beginPath();
            bctx.arc(p.x, p.y, p.r + 5, 0, Math.PI * 2);
            bctx.stroke();

            bctx.fillStyle = '#ffffff';
            bctx.beginPath();
            bctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
            bctx.fill();

            bctx.font = '9px "JetBrains Mono", monospace';
            bctx.fillStyle = '#d1e4fa';
            bctx.fillText('ID-' + (idx + 1) + ' [' + Math.round(p.x) + ',' + Math.round(p.y) + ']', p.x + 10, p.y + 3);
          });

          requestAnimationFrame(renderBlobPreview);
        }
        renderBlobPreview();
      }

      // 3. ASCII Matrix Preview Simulation
      var asciiCanvas = document.getElementById('asciiPreviewCanvas');
      if (asciiCanvas) {
        var actx = asciiCanvas.getContext('2d');
        var aw = asciiCanvas.width;
        var ah = asciiCanvas.height;
        var glyphs = ['0', '1', '.', ':', '-', '=', '+', '*', '#', '%', '@', '█', '░', '▒', '●'];
        var at = 0;

        function renderAsciiPreview() {
          at += 0.03;
          actx.clearRect(0, 0, aw, ah);

          actx.font = '11px "JetBrains Mono", monospace';
          actx.textAlign = 'center';
          actx.textBaseline = 'middle';

          var cols = 28;
          var rows = 12;
          var cellW = aw / cols;
          var cellH = ah / rows;

          for (var r = 0; r < rows; r++) {
            for (var c = 0; c < cols; c++) {
              var wave = Math.sin(c * 0.3 + at) * Math.cos(r * 0.4 + at);
              var glyphIdx = Math.floor(((wave + 1) / 2) * (glyphs.length - 1));
              var glyph = glyphs[glyphIdx] || ' ';

              if (wave > 0.4) {
                actx.fillStyle = '#ffffff';
              } else if (wave > -0.1) {
                actx.fillStyle = '#663af3';
              } else {
                actx.fillStyle = 'rgba(186, 215, 247, 0.25)';
              }

              actx.fillText(glyph, c * cellW + cellW / 2, r * cellH + cellH / 2);
            }
          }

          requestAnimationFrame(renderAsciiPreview);
        }
        renderAsciiPreview();
      }

      // 4. 1-Bit Dither Preview Simulation
      var ditherCanvas = document.getElementById('ditherPreviewCanvas');
      if (ditherCanvas) {
        var dctx = ditherCanvas.getContext('2d');
        var dw = ditherCanvas.width;
        var dh = ditherCanvas.height;
        var dt = 0;
        var bayer4 = [
          [ 0,  8,  2, 10],
          [12,  4, 14,  6],
          [ 3, 11,  1,  9],
          [15,  7, 13,  5]
        ];

        function renderDitherPreview() {
          dt += 0.03;
          dctx.clearRect(0, 0, dw, dh);

          var pixelSize = 6;
          var cols = Math.floor(dw / pixelSize);
          var rows = Math.floor(dh / pixelSize);
          var cx = cols / 2;
          var cy = rows / 2;
          var radius = Math.min(cols, rows) * 0.42;

          for (var y = 0; y < rows; y++) {
            for (var x = 0; x < cols; x++) {
              var dx = x - cx;
              var dy = y - cy;
              var dist = Math.sqrt(dx * dx + dy * dy);
              var lum = 0.5 + 0.45 * Math.sin(dist * 0.25 - dt) * Math.cos(x * 0.08 + dt * 0.5);
              lum = Math.max(0, Math.min(1, lum));

              var threshold = (bayer4[y % 4][x % 4] + 0.5) / 16;
              if (lum > threshold) {
                dctx.fillStyle = (dist < radius * 0.6) ? '#ffffff' : '#885dfc';
                dctx.fillRect(x * pixelSize, y * pixelSize, pixelSize - 1, pixelSize - 1);
              } else {
                dctx.fillStyle = '#0a0d1d';
                dctx.fillRect(x * pixelSize, y * pixelSize, pixelSize - 1, pixelSize - 1);
              }
            }
          }

          dctx.font = '9px "JetBrains Mono", monospace';
          dctx.fillStyle = '#a6b2c8';
          dctx.fillText('1-BIT // BAYER 4x4 // 80x33 CELLS', 10, dh - 10);

          requestAnimationFrame(renderDitherPreview);
        }
        renderDitherPreview();
      }

      // 5. CRT Synthesizer Preview Simulation
      var crtCanvas = document.getElementById('crtPreviewCanvas');
      if (crtCanvas) {
        var cctx = crtCanvas.getContext('2d');
        var cw = crtCanvas.width;
        var ch = crtCanvas.height;
        var ct = 0;

        function renderCrtPreview() {
          ct += 0.04;
          cctx.clearRect(0, 0, cw, ch);

          // Dark CRT tube backdrop
          cctx.fillStyle = '#03050c';
          cctx.fillRect(0, 0, cw, ch);

          // Glowing oscilloscope / radar wave
          var cx = cw / 2;
          var cy = ch / 2;

          // Waveform
          cctx.lineWidth = 2.5;
          // Red channel split
          cctx.strokeStyle = 'rgba(255, 50, 50, 0.7)';
          cctx.beginPath();
          for (var x = 0; x < cw; x += 4) {
            var yR = cy + Math.sin(x * 0.04 + ct) * 35 + Math.cos(x * 0.02 - ct * 1.5) * 18;
            if (x === 0) cctx.moveTo(x - 3, yR); else cctx.lineTo(x - 3, yR);
          }
          cctx.stroke();

          // Blue channel split
          cctx.strokeStyle = 'rgba(50, 150, 255, 0.7)';
          cctx.beginPath();
          for (var bx = 0; bx < cw; bx += 4) {
            var yB = cy + Math.sin(bx * 0.04 + ct) * 35 + Math.cos(bx * 0.02 - ct * 1.5) * 18;
            if (bx === 0) cctx.moveTo(bx + 3, yB); else cctx.lineTo(bx + 3, yB);
          }
          cctx.stroke();

          // Green primary beam
          cctx.strokeStyle = '#33ff66';
          cctx.beginPath();
          for (var gx = 0; gx < cw; gx += 4) {
            var yG = cy + Math.sin(gx * 0.04 + ct) * 35 + Math.cos(gx * 0.02 - ct * 1.5) * 18;
            if (gx === 0) cctx.moveTo(gx, yG); else cctx.lineTo(gx, yG);
          }
          cctx.stroke();

          // Scanlines
          cctx.fillStyle = 'rgba(0, 0, 0, 0.45)';
          for (var sl = 0; sl < ch; sl += 4) {
            cctx.fillRect(0, sl + 2, cw, 2);
          }

          // Subtle aperture grille stripes
          cctx.fillStyle = 'rgba(182, 217, 252, 0.04)';
          for (var ag = 0; ag < cw; ag += 6) {
            cctx.fillRect(ag, 0, 2, ch);
          }

          // OSD Text
          cctx.font = 'bold 10px "JetBrains Mono", monospace';
          cctx.fillStyle = '#33ff66';
          cctx.shadowColor = '#33ff66';
          cctx.shadowBlur = 6;
          cctx.fillText('CH 03 [NTSC] · 15.75 kHz', 14, 22);
          cctx.shadowBlur = 0;

          // Corner vignette
          var vig = cctx.createRadialGradient(cx, cy, ch * 0.35, cx, cy, ch * 0.85);
          vig.addColorStop(0, 'rgba(0,0,0,0)');
          vig.addColorStop(1, 'rgba(0,0,0,0.75)');
          cctx.fillStyle = vig;
          cctx.fillRect(0, 0, cw, ch);

          requestAnimationFrame(renderCrtPreview);
        }
        renderCrtPreview();
      }
    })();

    // PWA Service Worker Registration
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('./sw.js').catch(function (err) {
          console.log('SW registration skipped:', err);
        });
      });
    }
  </script>
</body>
</html>
