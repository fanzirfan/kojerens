---
import '../styles/global.css';
import '../styles/landing.css';
import { APP_VERSIONS } from '../config/versions';
import MobileAdvisory from '../components/MobileAdvisory.astro';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>KOJERENS : Generative Visual & Computational Design Studio</title>
  <meta name="description" content="KOJERENS is a browser-native generative visual laboratory engineered for luminance contrast centroid tracking, technical vector telemetry, real-time Unicode ASCII art synthesis, 1-bit error-diffusion dithering, and analog CRT beam simulation." />
  <meta name="keywords" content="kojerens, generative design, visual engineering, blob tracker, ascii art, dither, 1-bit, crt synthesizer, scanlines, creative coding, browser-native, broadside, dark mode" />
  <meta name="author" content="Fanz Irfan" />
  <meta name="robots" content="index,follow" />

  <!-- Canonical & Open Graph -->
  <link rel="canonical" href="https://kojerens.manji.eu.org/" />
  <meta property="og:title" content="KOJERENS : Generative Visual & Computational Design Studio" />
  <meta property="og:description" content="Explore client-side generative visual engines: Blob Tracker, ASCII Matrix, 1-Bit Dither Matrix & Analog CRT Synthesizer." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kojerens.manji.eu.org/" />
  <meta property="og:image" content="/assets/brand/logo.png" />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/brand/favicon-48x48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#141312" />

  <!-- Anti-FOUC Theme Initialization Script (Default to Warm Cream Paper Broadside) -->
  <script is:inline>
    (function () {
      var saved = localStorage.getItem('kojerens-theme');
      if (saved === 'dark') {
        document.documentElement.setAttribute('data-theme', 'dark');
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.setAttribute('data-theme', 'light');
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
</head>
<body>

  <!-- TOP TICKER BANNER (ANNOUNCEMENT STRIP) -->
  <aside class="top-ticker" aria-label="Laboratory Announcement">
    <div class="top-ticker-content">
      <span class="top-ticker-flag">
        <span class="top-ticker-dot"></span>
        COMPUTATIONAL VISUAL STUDIO
      </span>
      <span>/</span>
      <span>100% IN-BROWSER PROCESSING</span>
      <span>/</span>
      <span>ZERO CLOUD DATA TRANSMISSION</span>
    </div>
    <div class="top-ticker-content" style="font-family: var(--font-mono); font-size: 10px;">
      <span>KOJERENS.MANJI.EU.ORG // {APP_VERSIONS.hub.version}</span>
    </div>
  </aside>

  <!-- EDITORIAL NAVIGATION -->
  <header>
    <nav class="page-nav" aria-label="Main Navigation">
      <div class="nav-brand-group">
        <a href="/" class="nav-brand">
          <span class="nav-brand-star">✷</span>
          <span>ver. {APP_VERSIONS.hub.version.replace('v', '')}</span>
        </a>
        <p class="nav-tagline">(the Computational Design &amp; Visual Synthesis Studio of <strong>Fanz Irfan</strong>)</p>
      </div>

      <div class="nav-right-group">
        <ul class="nav-links" role="list">
          <li><a href="#engines" class="nav-link">Engines</a></li>
          <li><a href="#manifesto" class="nav-link">Manifesto</a></li>
          <li><a href="#architecture" class="nav-link">Architecture</a></li>
          <li>
            <a href="https://github.com/fanzirfan/kojerens" target="_blank" rel="noopener" class="nav-link">
              GitHub ↗
            </a>
          </li>
        </ul>

        <!-- Broadside Theme Toggle Button -->
        <button id="themeToggleBtn" class="theme-toggle-btn" aria-label="Toggle Dark and Light Mode" title="Toggle theme">
          <span class="theme-toggle-icon">◑</span>
          <span id="themeToggleText">DARK</span>
        </button>
      </div>
    </nav>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="home-hero">
      <div class="container">
        <div class="hero-grid">
          
          <!-- Left Hero Copy -->
          <div class="hero-copy">
            <div>
              <div class="hero-eyebrow">
                <span>✷ KOJERENS LABORATORY</span>
                <span>/</span>
                <span>AUTONOMOUS GRAPHICS ENGINE</span>
              </div>

              <h1 class="hero-title">
                <span class="segment">Generative Systems</span>
                <span class="segment segment--italic">of the</span>
                <span class="segment">Visual Laboratory</span>
              </h1>

              <p class="hero-description">
                The personal generative visual laboratory of Denver and Jakarta-based creative technologist and designer Fanz Irfan. Engineered for luminance contrast centroid tracking, technical vector telemetry, real-time Unicode ASCII art synthesis, 1-bit error-diffusion dithering, and analog cathode ray tube simulation.
              </p>

              <span class="hero-warning">
                (Scroll with curiosity and intention · All procedural algorithms execute locally on client hardware)
              </span>
            </div>

            <div class="hero-actions">
              <a href="#engines" class="btn-broadside">
                Explore Creative Engines ↓
              </a>
              <a href="https://github.com/fanzirfan/kojerens" target="_blank" rel="noopener" class="btn-broadside-ghost">
                Source Code on GitHub ↗
              </a>
            </div>
          </div>

          <!-- Right Hero Halftone Plate -->
          <div class="hero-plate-container">
            <div class="halftone-plate" aria-label="1-Bit Generative Halftone Plate">
              <!-- Precision Technical Corner Brackets -->
              <span class="reticle-bracket reticle-tl" aria-hidden="true"></span>
              <span class="reticle-bracket reticle-tr" aria-hidden="true"></span>
              <span class="reticle-bracket reticle-bl" aria-hidden="true"></span>
              <span class="reticle-bracket reticle-br" aria-hidden="true"></span>

              <!-- Edge Calibration Notches -->
              <span class="reticle-notch reticle-notch-t" aria-hidden="true"></span>
              <span class="reticle-notch reticle-notch-b" aria-hidden="true"></span>
              <span class="reticle-notch reticle-notch-l" aria-hidden="true"></span>
              <span class="reticle-notch reticle-notch-r" aria-hidden="true"></span>

              <!-- Specimen Metadata Tags -->
              <span class="plate-corner-tl">Design &amp; Strategy</span>
              <span class="plate-corner-tr">Fanz Irfan</span>
              <span class="plate-corner-bl">kojerens.manji.eu.org</span>
              <span class="plate-corner-br">Indonesia</span>
              <canvas id="halftoneHeroCanvas" class="plate-canvas" width="480" height="480"></canvas>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- CONTINUOUS COORDINATE MARQUEE -->
    <section class="coordinate-marquee" aria-label="Live Telemetry Marquee">
      <div class="marquee-track">
        <div class="marquee-item">
          <span>● LIVE CLIENT-SIDE PIPELINE</span>
          <span class="marquee-sep">/</span>
          <span>KOJERENS.MANJI.EU.ORG</span>
          <span class="marquee-sep">/</span>
          <span>S 06° 12' 52" E 106° 50' 42" (JAKARTA, INDONESIA)</span>
          <span class="marquee-sep">/</span>
          <span id="marqueeClock">12:00:00 AM WIB</span>
          <span class="marquee-sep">/</span>
          <span>FANZ IRFAN</span>
          <span class="marquee-sep">/</span>
          <span>ZERO EXTERNAL SERVER DEPENDENCY</span>
          <span class="marquee-sep">/</span>
          <span>60/120 FPS GPU ACCELERATED</span>
          <span class="marquee-sep">/</span>
        </div>
        <!-- Duplicated track for continuous seamless scroll -->
        <div class="marquee-item" aria-hidden="true">
          <span>● LIVE CLIENT-SIDE PIPELINE</span>
          <span class="marquee-sep">/</span>
          <span>KOJERENS.MANJI.EU.ORG</span>
          <span class="marquee-sep">/</span>
          <span>S 06° 12' 52" E 106° 50' 42" (JAKARTA, INDONESIA)</span>
          <span class="marquee-sep">/</span>
          <span id="marqueeClockDup">12:00:00 AM WIB</span>
          <span class="marquee-sep">/</span>
          <span>FANZ IRFAN</span>
          <span class="marquee-sep">/</span>
          <span>ZERO EXTERNAL SERVER DEPENDENCY</span>
          <span class="marquee-sep">/</span>
          <span>60/120 FPS GPU ACCELERATED</span>
          <span class="marquee-sep">/</span>
        </div>
      </div>
    </section>

    <!-- INVERTED EDITORIAL LETTER -->
    <section class="editorial-letter" aria-label="A Brief Letter From The Laboratory">
      <div class="letter-container">
        <p class="letter-eyebrow">A Brief Letter From The Laboratory</p>

        <div class="letter-prose">
          <p>dear visitor <i>(and fellow visual engineer)</i>,</p>
          <p>
            this laboratory represents a deliberate return to procedural mechanics, mathematical aesthetics, and direct pixel manipulation: an antidote to black-box generative models and disposable cloud templates.
          </p>
          <p>
            here, every contrast centroid is calculated locally; every ASCII character ramp is synthesized in memory; every 1-bit bitmap is diffused through integer math; and every analog beam blooms directly inside your browser.
          </p>
          <p>
            tread deliberately, for the ground is alive with mathematics.
          </p>
        </div>

        <p class="letter-signoff">
          with respect,<br />
          fanz irfan <i>(from kojerens)</i>
        </p>

        <div class="letter-bottom-rule"></div>
        <p class="letter-colophon-tag">KOJERENS COMPUTATIONAL DESIGN ARCHITECTURE // MMXXVI</p>
      </div>
    </section>

    <!-- STAMPED SECTION HEADER -->
    <section class="stamped-masthead" aria-label="Section Header: Selected Engines">
      <div class="stamped-header-row">
        <h2 class="stamped-title">SELECTED ENGINES</h2>
        <div class="stamped-trailing-rule"></div>
      </div>
    </section>

    <!-- ENGINES SHOWCASE -->
    <section class="engines-section" id="engines">
      <div class="container">
        <div class="section-intro-row">
          <div class="section-intro-left">
            <p class="section-eyebrow">// PRODUCTION SUITE</p>
            <h3 class="section-display-title">Browser-Native Creative Tools</h3>
          </div>
          <p class="section-intro-right">
            Engineered for visual researchers, art directors, and creative coders. 100% client-side computing with scalable exports.
          </p>
        </div>

        <div class="engines-grid">
          
          <!-- ENGINE 1: BLOB TRACKER -->
          <article class="engine-card">
            <div class="engine-card-left">
              <div>
                <div class="engine-meta-row">
                  <span class="engine-index">[01]</span>
                  <span class="engine-category">Vector Telemetry &amp; Feature Centroid Engine</span>
                </div>

                <div class="engine-title-group">
                  <h4 class="engine-title">Blob Tracker</h4>
                </div>

                <p class="engine-description">
                  Upload any image to analyze high-contrast luminance centroids. Generates sci-fi HUD telemetry, topographic geodetic elevation curves via Marching Squares, constellation coordinate grids, and minimalist editorial framing.
                </p>

                <div class="engine-tags">
                  <span class="engine-tag">Sensor Constellation</span>
                  <span class="engine-tag">Sci-Fi Telemetry</span>
                  <span class="engine-tag">Marching Squares Topo</span>
                  <span class="engine-tag">40 GRD Gradient Maps</span>
                  <span class="engine-tag">Transparent PNG Export</span>
                </div>
              </div>

              <div class="engine-action-row">
                <span class="engine-version-spec">{APP_VERSIONS.blobTracker.version} · 4 Sub-Engines · 60/120fps GPU</span>
                <a href="/blob-tracker/" class="btn-engine-launch">
                  Launch Blob Tracker →
                </a>
              </div>
            </div>

            <div class="engine-preview-wrap">
              <canvas id="blobPreviewCanvas" class="engine-canvas" width="480" height="300"></canvas>
            </div>
          </article>

          <!-- ENGINE 2: ASCII MATRIX -->
          <article class="engine-card">
            <div class="engine-card-left">
              <div>
                <div class="engine-meta-row">
                  <span class="engine-index">[02]</span>
                  <span class="engine-category">Unicode Glyph Art Synthesizer</span>
                </div>

                <div class="engine-title-group">
                  <h4 class="engine-title">ASCII Matrix</h4>
                </div>

                <p class="engine-description">
                  Transforms high-resolution photography into rich multi-language Unicode character art and terminal glyph matrices. Features multi-pass bloom, photographic exposure control, color quantization, and pure plaintext/image export.
                </p>

                <div class="engine-tags">
                  <span class="engine-tag">Unicode Character Ramps</span>
                  <span class="engine-tag">Multi-Pass Bloom</span>
                  <span class="engine-tag">Photographic Exposure</span>
                  <span class="engine-tag">Custom Character Sets</span>
                  <span class="engine-tag">Pure Text Download</span>
                </div>
              </div>

              <div class="engine-action-row">
                <span class="engine-version-spec">{APP_VERSIONS.asciiGen.version} · Unicode Synthesizer · Text &amp; PNG</span>
                <a href="/ascii-gen/" class="btn-engine-launch">
                  Launch ASCII Matrix →
                </a>
              </div>
            </div>

            <div class="engine-preview-wrap">
              <canvas id="asciiPreviewCanvas" class="engine-canvas" width="480" height="300"></canvas>
            </div>
          </article>

          <!-- ENGINE 3: 1-BIT DITHER MATRIX -->
          <article class="engine-card">
            <div class="engine-card-left">
              <div>
                <div class="engine-meta-row">
                  <span class="engine-index">[03]</span>
                  <span class="engine-category">1-Bit Error Diffusion &amp; Ordered Dither</span>
                </div>

                <div class="engine-title-group">
                  <h4 class="engine-title">1-Bit Dither</h4>
                </div>

                <p class="engine-description">
                  Synthesizes photographs into high-contrast retro bitmap graphics across 15 mathematical dithering algorithms: Atkinson, Floyd-Steinberg, Bayer 8x8/4x4/2x2 matrices, Halftone Dot/Line, Sierra-3, Stucki, and scalable vector SVG export.
                </p>

                <div class="engine-tags">
                  <span class="engine-tag">15 Dither Engines</span>
                  <span class="engine-tag">Bayer 8x8 &amp; Halftone</span>
                  <span class="engine-tag">12 Retro Palettes</span>
                  <span class="engine-tag">Scalable SVG Export</span>
                  <span class="engine-tag">Integer Pixel Scale</span>
                </div>
              </div>

              <div class="engine-action-row">
                <span class="engine-version-spec">{APP_VERSIONS.ditherGen.version} · 15 Algorithms · Vector SVG &amp; PNG</span>
                <a href="/dither-gen/" class="btn-engine-launch">
                  Launch 1-Bit Dither →
                </a>
              </div>
            </div>

            <div class="engine-preview-wrap">
              <canvas id="ditherPreviewCanvas" class="engine-canvas" width="480" height="300"></canvas>
            </div>
          </article>

          <!-- ENGINE 4: ANALOG CRT SYNTHESIZER -->
          <article class="engine-card">
            <div class="engine-card-left">
              <div>
                <div class="engine-meta-row">
                  <span class="engine-index">[04]</span>
                  <span class="engine-category">Analog Beam Dynamics &amp; Glitch Laboratory</span>
                </div>

                <div class="engine-title-group">
                  <h4 class="engine-title">CRT Synthesizer</h4>
                </div>

                <p class="engine-description">
                  Accurately simulates cathode ray tube electron physics, Trinitron aperture grilles, triad phosphor shadow masks, electron beam bloom, chromatic aberration, NTSC composite color bleed, and VHS tracking jitter.
                </p>

                <div class="engine-tags">
                  <span class="engine-tag">Trinitron Aperture Grille</span>
                  <span class="engine-tag">Triad Shadow Mask</span>
                  <span class="engine-tag">Barrel Tube Curvature</span>
                  <span class="engine-tag">VHS Sync Jitter</span>
                  <span class="engine-tag">Transparent Overlay Export</span>
                </div>
              </div>

              <div class="engine-action-row">
                <span class="engine-version-spec">{APP_VERSIONS.crtGen.version} · 8 Presets · Broadcast OSD · Video Sync</span>
                <a href="/crt-gen/" class="btn-engine-launch">
                  Launch CRT Synthesizer →
                </a>
              </div>
            </div>

            <div class="engine-preview-wrap">
              <canvas id="crtPreviewCanvas" class="engine-canvas" width="480" height="300"></canvas>
            </div>
          </article>

        </div>
      </div>
    </section>

    <!-- INVERTED BRAND TICKER BAND -->
    <section class="ticker-strip-dark" aria-label="Engine Keywords Strip">
      <div class="ticker-strip-track">
        <span>BLOB TRACKER</span>
        <span class="ticker-badge-pill">60/120 FPS</span>
        <span>ASCII MATRIX</span>
        <span class="ticker-badge-pill">UNICODE</span>
        <span>1-BIT DITHER</span>
        <span class="ticker-badge-pill">ATKINSON</span>
        <span>CRT SYNTHESIZER</span>
        <span class="ticker-badge-pill">TRINITRON</span>
        <span>CENTROID TELEMETRY</span>
        <span class="ticker-badge-pill">CLIENT-SIDE</span>
        <span>MARCHING SQUARES</span>
        <span class="ticker-badge-pill">ZERO SERVER</span>
        <span>ERROR DIFFUSION</span>
        <span class="ticker-badge-pill">OPEN SOURCE</span>
      </div>
    </section>

    <!-- MANIFESTO & ARCHITECTURE SECTION -->
    <section class="manifesto-section" id="manifesto">
      <div class="container">
        <div class="manifesto-grid">
          
          <div>
            <p class="section-eyebrow">// LABORATORY PHILOSOPHY</p>
            <h3 class="manifesto-heading">Built for Precision, Privacy &amp; Procedural Aesthetics</h3>

            <p class="manifesto-paragraph">
              Traditional online graphic utilities silently upload your high-resolution photographs to remote computing clusters for server-side processing. <strong>KOJERENS operates on an uncompromising 100% client-side execution philosophy</strong>.
            </p>

            <p class="manifesto-paragraph">
              All pixel rasterization, error-diffusion arrays, luminance tracking, and cathode ray tube simulations execute entirely within your browser context utilizing offscreen canvas buffers and GPU-accelerated requestAnimationFrame scheduling.
            </p>

            <p class="manifesto-paragraph">
              No telemetry pixels, no external database dependencies, no paywalls. Pure algorithmic tools designed for visual engineers, researchers, and typographers.
            </p>

            <div style="margin-top: 36px;">
              <a href="https://github.com/fanzirfan/kojerens" target="_blank" rel="noopener" class="btn-broadside">
                Inspect Source Code on GitHub ↗
              </a>
            </div>
          </div>

          <div id="architecture">
            <div class="spec-table-container">
              <div class="spec-table-header">
                System Specification &amp; Colophon
              </div>
              <div class="spec-row">
                <span class="spec-label">Project</span>
                <span class="spec-value">KOJERENS Visual Lab</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Author &amp; Engineering</span>
                <span class="spec-value">Fanz Irfan</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Primary Domain</span>
                <span class="spec-value">kojerens.manji.eu.org</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Architecture Stack</span>
                <span class="spec-value">Astro v5 · Tailwind v4 · Bun · Canvas2D</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Execution Pipeline</span>
                <span class="spec-value">100% Client-Side In-Browser</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Attribution Standard</span>
                <span class="spec-value">4-Corner Technical Broadside</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">Origin Location</span>
                <span class="spec-value">Indonesia</span>
              </div>
              <div class="spec-row">
                <span class="spec-label">License</span>
                <span class="spec-value">Open Source (MIT)</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>
  </main>

  <!-- EDITORIAL COLOPHON FOOTER -->
  <footer class="editorial-footer">
    <div class="container">
      <div class="footer-nav-grid">
        
        <!-- Col 1: Brand & Tagline -->
        <div class="footer-col-brand">
          <h4 class="footer-brand-title">KOJERENS</h4>
          <p class="footer-brand-subtitle">
            Generative Visual &amp; Computational Design Studio. Engineered for high-performance procedural imagery in the browser.
          </p>
          <div>
            <span class="footer-domain-badge">HOST: kojerens.manji.eu.org</span>
          </div>
        </div>

        <!-- Col 2: Production Engines -->
        <div>
          <h5 class="footer-col-title">Generative Engines</h5>
          <ul class="footer-link-list">
            <li class="footer-link-item">
              <a href="/blob-tracker/">Blob Tracker</a>
              <span class="footer-link-desc">Luminance &amp; centroid tracking</span>
            </li>
            <li class="footer-link-item">
              <a href="/ascii-gen/">ASCII Matrix</a>
              <span class="footer-link-desc">Unicode glyph synthesizer</span>
            </li>
            <li class="footer-link-item">
              <a href="/dither-gen/">1-Bit Dither</a>
              <span class="footer-link-desc">15 Error diffusion engines</span>
            </li>
            <li class="footer-link-item">
              <a href="/crt-gen/">CRT Synthesizer</a>
              <span class="footer-link-desc">Analog Trinitron &amp; glitch</span>
            </li>
          </ul>
        </div>

        <!-- Col 3: Architecture -->
        <div>
          <h5 class="footer-col-title">Architecture</h5>
          <ul class="footer-link-list">
            <li class="footer-link-item">
              <a href="#manifesto">Laboratory Manifesto</a>
              <span class="footer-link-desc">Zero cloud footprint philosophy</span>
            </li>
            <li class="footer-link-item">
              <a href="#architecture">Technical Stack</a>
              <span class="footer-link-desc">Astro v5, Bun, Tailwind v4</span>
            </li>
            <li class="footer-link-item">
              <a href="/manifest.json">Web App Manifest</a>
              <span class="footer-link-desc">PWA offline execution spec</span>
            </li>
          </ul>
        </div>

        <!-- Col 4: Identity & Elsewhere -->
        <div>
          <h5 class="footer-col-title">Identity &amp; Elsewhere</h5>
          <ul class="footer-link-list">
            <li class="footer-link-item">
              <a href="https://github.com/fanzirfan/kojerens" target="_blank" rel="noopener">GitHub ↗</a>
              <span class="footer-link-desc">Repository &amp; open source code</span>
            </li>
            <li class="footer-link-item">
              <a href="https://kojerens.manji.eu.org" target="_blank" rel="noopener">kojerens.manji.eu.org ↗</a>
              <span class="footer-link-desc">Primary production laboratory host</span>
            </li>
            <li class="footer-link-item">
              <a href="https://manji.eu.org" target="_blank" rel="noopener">manji.eu.org ↗</a>
              <span class="footer-link-desc">Author portfolio &amp; network</span>
            </li>
          </ul>
        </div>

      </div>

      <!-- Colophon Bottom Readout -->
      <div class="footer-colophon-bottom">
        <div class="colophon-left">
          <span>° S 06° 12' 52" E 106° 50' 42" (JAKARTA, INDONESIA)</span>
          <span>/</span>
          <span class="colophon-coords">FANZ IRFAN</span>
          <span>/</span>
          <span>Design &amp; Strategy</span>
        </div>
        <div class="colophon-right">
          <span>© 2026 Fanz Irfan · kojerens.manji.eu.org · All generative math runs in-browser</span>
        </div>
      </div>
    </div>
  </footer>

  <!-- CLIENT-SIDE VISUAL PROCEDURAL SCRIPT -->
  <script is:inline>
    (function () {
      // 1. Theme Helper Function
      function isDark() {
        return document.documentElement.classList.contains('dark') ||
               document.documentElement.getAttribute('data-theme') === 'dark';
      }

      // 2. Theme Toggle Controller
      var toggleBtn = document.getElementById('themeToggleBtn');
      var toggleText = document.getElementById('themeToggleText');

      function syncToggleState() {
        var currentIsDark = isDark();
        if (toggleText) {
          toggleText.textContent = currentIsDark ? 'DARK' : 'LIGHT';
        }
      }
      syncToggleState();

      if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
          var willBeDark = !isDark();
          if (willBeDark) {
            document.documentElement.setAttribute('data-theme', 'dark');
            document.documentElement.classList.add('dark');
            localStorage.setItem('kojerens-theme', 'dark');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
            document.documentElement.classList.remove('dark');
            localStorage.setItem('kojerens-theme', 'light');
          }
          syncToggleState();
        });
      }

      // 3. Live WIB Time Synchronizer for Marquees
      function updateClocks() {
        var now = new Date();
        var options = {
          timeZone: 'Asia/Jakarta',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: true
        };
        var timeStr = now.toLocaleTimeString('en-US', options) + ' WIB';
        var c1 = document.getElementById('marqueeClock');
        var c2 = document.getElementById('marqueeClockDup');
        if (c1) c1.textContent = timeStr;
        if (c2) c2.textContent = timeStr;
      }
      setInterval(updateClocks, 1000);
      updateClocks();

      // 4. Hero 1-Bit Halftone Plate Canvas: Procedural Computational Astrolabe & Centroid Gyroscope
      var heroPlateCanvas = document.getElementById('halftoneHeroCanvas');
      var heroPlateBox = document.querySelector('.halftone-plate');
      if (heroPlateCanvas) {
        var pctx = heroPlateCanvas.getContext('2d');
        var dpr = window.devicePixelRatio || 1;
        var pw = 480;
        var ph = 480;
        heroPlateCanvas.width = pw * dpr;
        heroPlateCanvas.height = ph * dpr;
        pctx.scale(dpr, dpr);

        var pt = 0;
        var mouse = { x: pw / 2, y: ph / 2, tx: pw / 2, ty: ph / 2, isHovered: false };

        if (heroPlateBox) {
          heroPlateBox.addEventListener('mousemove', function (e) {
            var rect = heroPlateBox.getBoundingClientRect();
            mouse.tx = Math.max(20, Math.min(pw - 20, ((e.clientX - rect.left) / rect.width) * pw));
            mouse.ty = Math.max(20, Math.min(ph - 20, ((e.clientY - rect.top) / rect.height) * ph));
            mouse.isHovered = true;
          });
          heroPlateBox.addEventListener('mouseleave', function () {
            mouse.isHovered = false;
          });
        }

        // 3D Polyhedron Model (Stellated Octahedron / Quantum Gyro Core)
        var R = 54;
        var vertices = [
          { x: 0, y: -R, z: 0 },
          { x: 0, y: R, z: 0 },
          { x: R, y: 0, z: 0 },
          { x: -R, y: 0, z: 0 },
          { x: 0, y: 0, z: R },
          { x: 0, y: 0, z: -R },
          // Stellated outer nodes
          { x: R * 0.55, y: R * 0.55, z: R * 0.55 },
          { x: -R * 0.55, y: R * 0.55, z: R * 0.55 },
          { x: R * 0.55, y: -R * 0.55, z: R * 0.55 },
          { x: -R * 0.55, y: -R * 0.55, z: R * 0.55 }
        ];

        var edges = [
          [0, 2], [0, 3], [0, 4], [0, 5],
          [1, 2], [1, 3], [1, 4], [1, 5],
          [2, 4], [4, 3], [3, 5], [5, 2],
          [6, 0], [6, 2], [6, 4],
          [7, 0], [7, 3], [7, 4],
          [8, 1], [8, 2], [8, 4],
          [9, 1], [9, 3], [9, 4]
        ];

        function project(x, y, z, yaw, pitch, roll, cx, cy) {
          var cosY = Math.cos(yaw);
          var sinY = Math.sin(yaw);
          var x1 = x * cosY - z * sinY;
          var z1 = x * sinY + z * cosY;

          var cosP = Math.cos(pitch);
          var sinP = Math.sin(pitch);
          var y2 = y * cosP - z1 * sinP;
          var z2 = y * sinP + z1 * cosP;

          var cosR = Math.cos(roll);
          var sinR = Math.sin(roll);
          var x3 = x1 * cosR - y2 * sinR;
          var y3 = x1 * sinR + y2 * cosR;

          var fov = 320;
          var scale = fov / (fov + z2 + 80);
          return {
            px: cx + x3 * scale,
            py: cy + y3 * scale,
            depth: z2,
            scale: scale
          };
        }

        // Autonomous Tracker nodes
        var trackers = [
          { speed: 0.8, radX: 130, radY: 85, phase: 0, label: 'TRK-01' },
          { speed: -0.6, radX: 95, radY: 130, phase: 2.1, label: 'TRK-02' },
          { speed: 1.1, radX: 150, radY: 55, phase: 4.3, label: 'TRK-03' }
        ];

        function renderHalftonePlate() {
          pt += 0.018;
          var dark = isDark();
          var bg = dark ? '#141312' : '#fafafa';
          var ink = dark ? '#fafafa' : '#2a2722';
          var grid = dark ? '#22201d' : '#ede8e1';
          var hairline = dark ? '#332e29' : '#d8d2c7';
          var metaText = dark ? '#8e8880' : '#736d65';
          var accent = dark ? '#d1cbbd' : '#454038';

          pctx.fillStyle = bg;
          pctx.fillRect(0, 0, pw, ph);

          var cx = pw / 2;
          var cy = ph / 2;

          // Smooth mouse interpolation
          if (!mouse.isHovered) {
            mouse.tx = cx + Math.sin(pt * 0.7) * 95;
            mouse.ty = cy + Math.cos(pt * 0.5) * 65;
          }
          mouse.x += (mouse.tx - mouse.x) * 0.07;
          mouse.y += (mouse.ty - mouse.y) * 0.07;

          var tiltX = ((mouse.x - cx) / cx);
          var tiltY = ((mouse.y - cy) / cy);

          // 1. Technical Cartesian Background Grid
          pctx.strokeStyle = grid;
          pctx.lineWidth = 1;
          for (var gx = 48; gx < pw; gx += 48) {
            pctx.beginPath();
            pctx.moveTo(gx, 0);
            pctx.lineTo(gx, ph);
            pctx.stroke();
          }
          for (var gy = 48; gy < ph; gy += 48) {
            pctx.beginPath();
            pctx.moveTo(0, gy);
            pctx.lineTo(pw, gy);
            pctx.stroke();
          }

          // Subtle corner crosshairs (+) safely inside
          var cornerCrosses = [[48, 48], [pw - 48, 48], [48, ph - 48], [pw - 48, ph - 48]];
          pctx.strokeStyle = hairline;
          pctx.lineWidth = 1;
          cornerCrosses.forEach(function (cpt) {
            pctx.beginPath();
            pctx.moveTo(cpt[0] - 6, cpt[1]);
            pctx.lineTo(cpt[0] + 6, cpt[1]);
            pctx.moveTo(cpt[0], cpt[1] - 6);
            pctx.lineTo(cpt[0], cpt[1] + 6);
            pctx.stroke();
          });

          // 2. Halftone Ripple Interference Matrix (1-Bit Generative Field)
          var rings = 10;
          for (var ri = 1; ri <= rings; ri++) {
            var rad = ri * 18;
            var dots = Math.floor(ri * 7.5);
            for (var di = 0; di < dots; di++) {
              var angle = (di / dots) * Math.PI * 2 + (ri % 2 === 0 ? pt * 0.15 : -pt * 0.2);
              var hx = cx + Math.cos(angle) * rad;
              var hy = cy + Math.sin(angle) * rad;

              var distMouse = Math.sqrt((hx - mouse.x) * (hx - mouse.x) + (hy - mouse.y) * (hy - mouse.y));
              var wave = Math.sin(distMouse * 0.06 - pt * 2.5) * Math.cos(angle * 3 + pt);
              var dotSize = Math.max(0.6, 1.2 + wave * 1.4);

              pctx.fillStyle = ink;
              pctx.beginPath();
              pctx.arc(hx, hy, dotSize, 0, Math.PI * 2);
              pctx.fill();
            }
          }

          // 3. Precision Outer Astrolabe Dial (Azimuth Gauge)
          var dialRadius = 200;
          pctx.strokeStyle = hairline;
          pctx.lineWidth = 1;
          pctx.beginPath();
          pctx.arc(cx, cy, dialRadius, 0, Math.PI * 2);
          pctx.stroke();

          // Outer tick marks
          var totalTicks = 72;
          for (var t = 0; t < totalTicks; t++) {
            var tAng = (t / totalTicks) * Math.PI * 2;
            var isMajor = t % 6 === 0;
            var tLen = isMajor ? 8 : 4;
            var cosT = Math.cos(tAng);
            var sinT = Math.sin(tAng);

            pctx.strokeStyle = isMajor ? ink : hairline;
            pctx.lineWidth = 1;
            pctx.beginPath();
            pctx.moveTo(cx + cosT * (dialRadius - tLen), cy + sinT * (dialRadius - tLen));
            pctx.lineTo(cx + cosT * dialRadius, cy + sinT * dialRadius);
            pctx.stroke();

            if (isMajor) {
              var deg = Math.round((t / totalTicks) * 360);
              var degStr = deg.toString().padStart(3, '0') + '°';
              pctx.font = '7.5px "JetBrains Mono", monospace';
              pctx.fillStyle = metaText;
              pctx.textAlign = 'center';
              pctx.textBaseline = 'middle';
              pctx.fillText(degStr, cx + cosT * (dialRadius - 16), cy + sinT * (dialRadius - 16));
            }
          }

          // Rotating Azimuth Radar Sweep Line
          var sweepAngle = pt * 1.2;
          pctx.strokeStyle = accent;
          pctx.lineWidth = 1;
          pctx.setLineDash([4, 4]);
          pctx.beginPath();
          pctx.moveTo(cx, cy);
          pctx.lineTo(cx + Math.cos(sweepAngle) * dialRadius, cy + Math.sin(sweepAngle) * dialRadius);
          pctx.stroke();
          pctx.setLineDash([]);

          // 4. 3D Gyroscopic Gimbal Rings (Astrolabe Rotors)
          var yaw = pt * 0.45 + tiltX * 0.45;
          var pitch = pt * 0.3 + tiltY * 0.45;
          var roll = pt * 0.15;

          // Gimbal Ring 1 (Tilted around Yaw/Pitch)
          var ringPts1 = [];
          var r1 = 155;
          for (var a = 0; a <= 40; a++) {
            var theta = (a / 40) * Math.PI * 2;
            var rx = Math.cos(theta) * r1;
            var ry = Math.sin(theta) * r1;
            ringPts1.push(project(rx, ry, 0, yaw, pitch, roll, cx, cy));
          }
          pctx.strokeStyle = hairline;
          pctx.lineWidth = 1.2;
          pctx.beginPath();
          ringPts1.forEach(function (rp, i) {
            if (i === 0) pctx.moveTo(rp.px, rp.py); else pctx.lineTo(rp.px, rp.py);
          });
          pctx.stroke();

          // Satellite beacon traveling on Ring 1
          var satIdx = Math.floor(((pt * 0.5) % 1) * ringPts1.length);
          var sat = ringPts1[satIdx] || ringPts1[0];
          pctx.fillStyle = ink;
          pctx.beginPath();
          pctx.arc(sat.px, sat.py, 3.5, 0, Math.PI * 2);
          pctx.fill();
          pctx.strokeStyle = ink;
          pctx.strokeRect(sat.px - 6, sat.py - 6, 12, 12);

          // Gimbal Ring 2 (Polar counter-rotation)
          var ringPts2 = [];
          var r2 = 115;
          for (var a2 = 0; a2 <= 36; a2++) {
            var theta2 = (a2 / 36) * Math.PI * 2;
            var rx2 = Math.cos(theta2) * r2;
            var rz2 = Math.sin(theta2) * r2;
            ringPts2.push(project(rx2, 0, rz2, -yaw * 0.8, pitch * 1.1, -roll, cx, cy));
          }
          pctx.strokeStyle = accent;
          pctx.lineWidth = 1;
          pctx.setLineDash([3, 5]);
          pctx.beginPath();
          ringPts2.forEach(function (rp2, i2) {
            if (i2 === 0) pctx.moveTo(rp2.px, rp2.py); else pctx.lineTo(rp2.px, rp2.py);
          });
          pctx.stroke();
          pctx.setLineDash([]);

          // 5. 3D Wireframe Polyhedron Core (Octahedron & Vertices)
          var projectedVerts = vertices.map(function (v) {
            return project(v.x, v.y, v.z, yaw * 1.2, pitch * 1.2, roll * 1.5, cx, cy);
          });

          // Draw Edges
          pctx.strokeStyle = ink;
          pctx.lineWidth = 1.2;
          edges.forEach(function (edge) {
            var p1 = projectedVerts[edge[0]];
            var p2 = projectedVerts[edge[1]];
            pctx.beginPath();
            pctx.moveTo(p1.px, p1.py);
            pctx.lineTo(p2.px, p2.py);
            pctx.stroke();
          });

          // Draw Vertex Centroid Nodes with Pulsing Halos
          projectedVerts.forEach(function (pv, vi) {
            var pulseSize = 2.5 + Math.sin(pt * 4 + vi) * 1;
            pctx.fillStyle = ink;
            pctx.beginPath();
            pctx.arc(pv.px, pv.py, pulseSize, 0, Math.PI * 2);
            pctx.fill();

            if (vi < 6) {
              pctx.strokeStyle = hairline;
              pctx.lineWidth = 1;
              pctx.beginPath();
              pctx.arc(pv.px, pv.py, pulseSize + 4, 0, Math.PI * 2);
              pctx.stroke();
            }
          });

          // 6. Dynamic Orbital Trackers & Constellation Network
          var trackerPoints = [];
          trackers.forEach(function (trk, ti) {
            var trkAngle = pt * trk.speed + trk.phase;
            var tx = cx + Math.cos(trkAngle) * trk.radX + Math.sin(pt * 0.4 + ti) * 20;
            var ty = cy + Math.sin(trkAngle) * trk.radY + Math.cos(pt * 0.3 + ti) * 15;
            trackerPoints.push({ x: tx, y: ty, label: trk.label });

            // Node dot
            pctx.fillStyle = ink;
            pctx.beginPath();
            pctx.arc(tx, ty, 3, 0, Math.PI * 2);
            pctx.fill();

            // Reticle frame [ ]
            pctx.strokeStyle = ink;
            pctx.lineWidth = 1;
            var bs = 7;
            pctx.beginPath();
            pctx.moveTo(tx - bs, ty - bs + 3);
            pctx.lineTo(tx - bs, ty - bs);
            pctx.lineTo(tx - bs + 3, ty - bs);
            pctx.moveTo(tx + bs, ty - bs + 3);
            pctx.lineTo(tx + bs, ty - bs);
            pctx.lineTo(tx + bs - 3, ty - bs);
            pctx.moveTo(tx - bs, ty + bs - 3);
            pctx.lineTo(tx - bs, ty + bs);
            pctx.lineTo(tx - bs + 3, ty + bs);
            pctx.moveTo(tx + bs, ty + bs - 3);
            pctx.lineTo(tx + bs, ty + bs);
            pctx.lineTo(tx + bs - 3, ty + bs);
            pctx.stroke();

            // Label
            pctx.font = '8px "JetBrains Mono", monospace';
            pctx.fillStyle = metaText;
            pctx.textAlign = 'left';
            pctx.textBaseline = 'middle';
            pctx.fillText(trk.label + ' [' + Math.round(tx) + ',' + Math.round(ty) + ']', tx + 10, ty);
          });

          // Constellation lines connecting nearby trackers & cursor
          var allNodes = trackerPoints.concat([{ x: mouse.x, y: mouse.y, label: 'CURSOR' }]);
          pctx.strokeStyle = hairline;
          pctx.lineWidth = 1;
          pctx.setLineDash([2, 4]);
          for (var n1 = 0; n1 < allNodes.length; n1++) {
            for (var n2 = n1 + 1; n2 < allNodes.length; n2++) {
              var dist = Math.hypot(allNodes[n1].x - allNodes[n2].x, allNodes[n1].y - allNodes[n2].y);
              if (dist < 140) {
                pctx.beginPath();
                pctx.moveTo(allNodes[n1].x, allNodes[n1].y);
                pctx.lineTo(allNodes[n2].x, allNodes[n2].y);
                pctx.stroke();
              }
            }
          }
          pctx.setLineDash([]);

          // 7. Interactive Primary Centroid Reticle at Mouse/Target
          pctx.strokeStyle = ink;
          pctx.lineWidth = 1.2;
          var mbs = 10;
          pctx.beginPath();
          pctx.moveTo(mouse.x - mbs, mouse.y);
          pctx.lineTo(mouse.x + mbs, mouse.y);
          pctx.moveTo(mouse.x, mouse.y - mbs);
          pctx.lineTo(mouse.x, mouse.y + mbs);
          pctx.stroke();

          pctx.beginPath();
          pctx.arc(mouse.x, mouse.y, 14, 0, Math.PI * 2);
          pctx.stroke();

          // 8. Safely Centered Telemetry Status Badges (Never collides with 4-corner tags!)
          var azimuthDeg = Math.round(((sweepAngle % (Math.PI * 2)) / (Math.PI * 2)) * 360);
          pctx.font = '8.5px "JetBrains Mono", monospace';
          pctx.fillStyle = metaText;
          pctx.textAlign = 'center';
          pctx.textBaseline = 'top';
          pctx.fillText('// PROCEDURAL COMPUTATIONAL ASTROLABE · VER 2.1 //', cx, 24);

          pctx.textBaseline = 'bottom';
          pctx.fillText('AZIMUTH: ' + azimuthDeg.toString().padStart(3, '0') + '° · L-RATIO: 0.88 · 60 FPS GPU-SYNC', cx, ph - 24);

          requestAnimationFrame(renderHalftonePlate);
        }
        renderHalftonePlate();
      }

      // 5. Engine 1: Blob Tracker Canvas Simulation (Theme Aware)
      var blobCanvas = document.getElementById('blobPreviewCanvas');
      if (blobCanvas) {
        var bctx = blobCanvas.getContext('2d');
        var bw = blobCanvas.width;
        var bh = blobCanvas.height;
        var bt = 0;

        function renderBlob() {
          bt += 0.02;
          var dark = isDark();
          var bg = dark ? '#141312' : '#fafafa';
          var ink = dark ? '#fafafa' : '#2a2722';
          var grid = dark ? '#24211e' : '#eeeeee';
          var contour = dark ? '#66615b' : '#9f9f9f';
          var wire = dark ? '#d9d3cb' : '#3e3b36';

          bctx.fillStyle = bg;
          bctx.fillRect(0, 0, bw, bh);

          var cx = bw / 2;
          var cy = bh / 2;

          // Technical hairline crosshairs
          bctx.strokeStyle = grid;
          bctx.lineWidth = 1;
          bctx.beginPath();
          bctx.moveTo(0, cy);
          bctx.lineTo(bw, cy);
          bctx.moveTo(cx, 0);
          bctx.lineTo(cx, bh);
          bctx.stroke();

          // Concentric geodetic contours
          for (var r = 30; r <= 110; r += 24) {
            bctx.strokeStyle = contour;
            bctx.lineWidth = 1;
            bctx.setLineDash([3, 4]);
            bctx.beginPath();
            bctx.arc(cx, cy, r + Math.sin(bt + r * 0.1) * 4, 0, Math.PI * 2);
            bctx.stroke();
          }
          bctx.setLineDash([]);

          // Tracking points
          var pts = [
            { x: cx + Math.cos(bt) * 60, y: cy + Math.sin(bt * 1.2) * 45, r: 6, label: 'CENTROID-01' },
            { x: cx - Math.cos(bt * 0.7) * 75, y: cy - Math.sin(bt) * 50, r: 8, label: 'CENTROID-02' },
            { x: cx + Math.sin(bt * 1.1) * 80, y: cy - Math.cos(bt * 0.8) * 60, r: 5, label: 'CENTROID-03' }
          ];

          // Constellation lines
          bctx.strokeStyle = wire;
          bctx.lineWidth = 1;
          bctx.beginPath();
          bctx.moveTo(pts[0].x, pts[0].y);
          bctx.lineTo(pts[1].x, pts[1].y);
          bctx.lineTo(pts[2].x, pts[2].y);
          bctx.closePath();
          bctx.stroke();

          pts.forEach(function (p) {
            bctx.fillStyle = ink;
            bctx.beginPath();
            bctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            bctx.fill();

            bctx.strokeStyle = ink;
            bctx.lineWidth = 1;
            bctx.beginPath();
            bctx.arc(p.x, p.y, p.r + 6, 0, Math.PI * 2);
            bctx.stroke();

            bctx.font = '9px "JetBrains Mono", monospace';
            bctx.fillStyle = ink;
            bctx.fillText(p.label + ' [' + Math.round(p.x) + ',' + Math.round(p.y) + ']', p.x + 10, p.y + 3);
          });

          requestAnimationFrame(renderBlob);
        }
        renderBlob();
      }

      // 6. Engine 2: ASCII Matrix Simulation (Theme Aware)
      var asciiCanvas = document.getElementById('asciiPreviewCanvas');
      if (asciiCanvas) {
        var actx = asciiCanvas.getContext('2d');
        var aw = asciiCanvas.width;
        var ah = asciiCanvas.height;
        var glyphs = ['0', '1', '.', ':', '-', '=', '+', '*', '#', '%', '@', '█', '░', '▒', '●'];
        var at = 0;

        function renderAscii() {
          at += 0.03;
          var dark = isDark();
          var bg = dark ? '#141312' : '#fafafa';
          var high = dark ? '#fafafa' : '#2a2722';
          var mid = dark ? '#9c958d' : '#666666';
          var low = dark ? '#5c5650' : '#b3b3b3';

          actx.fillStyle = bg;
          actx.fillRect(0, 0, aw, ah);

          actx.font = '11px "JetBrains Mono", monospace';
          actx.textAlign = 'center';
          actx.textBaseline = 'middle';

          var cols = 30;
          var rows = 14;
          var cellW = aw / cols;
          var cellH = ah / rows;

          for (var r = 0; r < rows; r++) {
            for (var c = 0; c < cols; c++) {
              var wave = Math.sin(c * 0.28 + at) * Math.cos(r * 0.35 + at);
              var glyphIdx = Math.floor(((wave + 1) / 2) * (glyphs.length - 1));
              var glyph = glyphs[glyphIdx] || ' ';

              if (wave > 0.3) {
                actx.fillStyle = high;
              } else if (wave > -0.1) {
                actx.fillStyle = mid;
              } else {
                actx.fillStyle = low;
              }

              actx.fillText(glyph, c * cellW + cellW / 2, r * cellH + cellH / 2);
            }
          }

          requestAnimationFrame(renderAscii);
        }
        renderAscii();
      }

      // 7. Engine 3: 1-Bit Dither Matrix Simulation (Theme Aware)
      var ditherCanvas = document.getElementById('ditherPreviewCanvas');
      if (ditherCanvas) {
        var dctx = ditherCanvas.getContext('2d');
        var dw = ditherCanvas.width;
        var dh = ditherCanvas.height;
        var dt = 0;
        var bayer4 = [
          [ 0,  8,  2, 10],
          [12,  4, 14,  6],
          [ 3, 11,  1,  9],
          [15,  7, 13,  5]
        ];

        function renderDither() {
          dt += 0.03;
          var dark = isDark();
          var bg = dark ? '#141312' : '#fafafa';
          var ink = dark ? '#fafafa' : '#2a2722';

          dctx.fillStyle = bg;
          dctx.fillRect(0, 0, dw, dh);

          var pixelSize = 6;
          var cols = Math.floor(dw / pixelSize);
          var rows = Math.floor(dh / pixelSize);
          var cx = cols / 2;
          var cy = rows / 2;

          for (var y = 0; y < rows; y++) {
            for (var x = 0; x < cols; x++) {
              var dx = x - cx;
              var dy = y - cy;
              var dist = Math.sqrt(dx * dx + dy * dy);
              var lum = 0.5 + 0.45 * Math.sin(dist * 0.22 - dt) * Math.cos(x * 0.07 + dt * 0.4);
              lum = Math.max(0, Math.min(1, lum));

              var threshold = (bayer4[y % 4][x % 4] + 0.5) / 16;
              if (lum > threshold) {
                dctx.fillStyle = ink;
                dctx.fillRect(x * pixelSize, y * pixelSize, pixelSize - 1, pixelSize - 1);
              }
            }
          }

          dctx.font = '9px "JetBrains Mono", monospace';
          dctx.fillStyle = ink;
          dctx.fillText('1-BIT BAYER 4x4 // 80x50 CELLS // SVG VECTOR', 14, dh - 14);

          requestAnimationFrame(renderDither);
        }
        renderDither();
      }

      // 8. Engine 4: CRT Synthesizer Simulation (Theme Aware)
      var crtCanvas = document.getElementById('crtPreviewCanvas');
      if (crtCanvas) {
        var cctx = crtCanvas.getContext('2d');
        var cw = crtCanvas.width;
        var ch = crtCanvas.height;
        var ct = 0;

        function renderCrt() {
          ct += 0.04;
          var dark = isDark();
          var bg = dark ? '#0d0c0b' : '#2a2722';
          var beam = '#fafafa';
          var beamEcho = dark ? '#66615b' : '#9f9f9f';

          cctx.fillStyle = bg;
          cctx.fillRect(0, 0, cw, ch);

          var cy = ch / 2;

          // Scanline raster
          cctx.fillStyle = 'rgba(250, 250, 250, 0.04)';
          for (var sl = 0; sl < ch; sl += 4) {
            cctx.fillRect(0, sl, cw, 2);
          }

          // Primary electron beam
          cctx.lineWidth = 2;
          cctx.strokeStyle = beam;
          cctx.beginPath();
          for (var x = 0; x < cw; x += 4) {
            var y = cy + Math.sin(x * 0.04 + ct) * 35 + Math.cos(x * 0.02 - ct * 1.5) * 18;
            if (x === 0) cctx.moveTo(x, y); else cctx.lineTo(x, y);
          }
          cctx.stroke();

          // Beam echo line (shadow)
          cctx.lineWidth = 1;
          cctx.strokeStyle = beamEcho;
          cctx.beginPath();
          for (var bx = 0; bx < cw; bx += 4) {
            var by = cy + Math.sin(bx * 0.04 + ct) * 35 + Math.cos(bx * 0.02 - ct * 1.5) * 18 + 4;
            if (bx === 0) cctx.moveTo(bx, by); else cctx.lineTo(bx, by);
          }
          cctx.stroke();

          // OSD Text
          cctx.font = 'bold 10px "JetBrains Mono", monospace';
          cctx.fillStyle = '#fafafa';
          cctx.fillText('NTSC COMPOSITE CH-01 · 15.75 kHz · MONOCHROME', 16, 26);

          requestAnimationFrame(renderCrt);
        }
        renderCrt();
      }

    })();

    // PWA Service Worker Registration
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', function () {
        navigator.serviceWorker.register('./sw.js').catch(function (err) {
          console.log('SW registration skipped:', err);
        });
      });
    }
  </script>
