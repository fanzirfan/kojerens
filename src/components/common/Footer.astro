---
const year = new Date().getFullYear();
---

<footer class="border-t border-[#bad6f7]/10 bg-[#05060f] py-12 px-6 md:px-12 text-xs font-mono text-[#9da7ba]">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <img src="/assets/brand/footer.png" alt="KOJERENS" class="w-6 h-6 object-contain" />
      <div>
        <span class="text-white font-semibold tracking-wider font-display">KOJERENS</span>
        <span class="mx-2 text-[#bad6f7]/20">/</span>
        <span>Generative Visual Laboratory</span>
      </div>
    </div>

    <!-- Attribution details strictly complying with guidelines -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-[#9da7ba]">
      <span>Design &amp; Strategy</span>
      <span class="text-[#bad6f7]/20">·</span>
      <span class="text-white font-medium">Fanz Irfan</span>
      <span class="text-[#bad6f7]/20">·</span>
      <a href="https://manji.eu.org" target="_blank" rel="noopener" class="hover:text-[#b6d9fc] transition">manji.eu.org</a>
      <span class="text-[#bad6f7]/20">·</span>
      <span>Indonesia</span>
    </div>

    <div class="text-right">
      <span>&copy; {year} KOJERENS · 100% Client-Side Engine</span>
    </div>
  </div>
</footer>
