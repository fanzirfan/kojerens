---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'KOJERENS | Generative Visual & Computational Design Studio',
  description = 'KOJERENS: A browser-native generative visual laboratory featuring high-performance contrast centroid tracking, HUD telemetry, Unicode ASCII art, 1-bit error-diffusion dithering, and analog CRT beam glitch synthesis.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Fanz Irfan" />
  <meta name="robots" content="index,follow" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://manji.eu.org" />
  <meta property="og:image" content="/assets/brand/logo.png" />

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/brand/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/brand/favicon-16x16.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/brand/favicon-48x48.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/brand/apple-icon.png" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#05060f" />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css" rel="stylesheet" />
</head>
<body class="bg-[#05060f] text-[#c7d3ea] antialiased selection:bg-[#663af3]/30 selection:text-white">
  <slot />
</body>
</html>
